HOST=127.0.0.1
PORT=3000

# PostgreSQL da aplicação: exemplo fictício; nunca usar produção nos testes.
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/mara_guerra

# WhatsApp Cloud API — cliente isolado, sem ativação nas rotas existentes.
# O cliente tem envio explícito; fila/interface permanecem bloqueadas por código.
# Não preencha nem use credenciais de produção durante testes automatizados.
# WHATSAPP_ACCESS_TOKEN=SUBSTITUIR_POR_TOKEN_NO_AMBIENTE_SEGURO
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Defina explicitamente uma versão suportada pela Meta, no formato vN.N.
# WHATSAPP_GRAPH_API_VERSION=v23.0
# Opcional: timeout total de conexão e leitura do corpo (1 a 120000 ms; padrão 10000).
# WHATSAPP_TIMEOUT_MS=10000

# Seleção explícita do processamento da fila (padrão simulado).
# Credenciais não mudam o provedor selecionado.
# WHATSAPP_PROVIDER=simulado
# Gate adicional obrigatório para uma futura liberação de envios reais.
# Mesmo true NÃO libera chamadas externas na fila/interface: há bloqueio de código.
# WHATSAPP_REAL_SEND_ENABLED=false

# Etapa 3: habilitar somente após validar 003 e 004 em banco LOCAL isolado.
# Nunca habilitar apontando para o Neon atual durante esta etapa.
# WHATSAPP_PERSISTENCE_ENABLED=false
# Token do handshake GET (não é o access token da Cloud API).
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=SUBSTITUIR_POR_TOKEN_DE_VERIFICACAO
# App Secret para HMAC dos bytes originais; nunca aparece em logs ou respostas.
# WHATSAPP_APP_SECRET=SUBSTITUIR_POR_APP_SECRET_NO_AMBIENTE_SEGURO
# Opcional: restringe também entry.id do WABA, além do Phone Number ID obrigatório no POST.
# WHATSAPP_WABA_ID=123456789012345

# Teste manual: configuração separada em .local/whatsapp-manual/config.json (ignorado).
# Não usa estas variáveis nem lê .env. Consulte docs/whatsapp-teste-manual.md.
# Verificação sem rede: bun --no-env-file run whatsapp:test --check
# Não habilite flags da fila para executar esse teste isolado.
